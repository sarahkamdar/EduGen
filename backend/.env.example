# ─── MongoDB / Amazon DocumentDB ─────────────────────────────────────────────
# Local dev (MongoDB Atlas):
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/edugen?w=majority
#
# Production (Amazon DocumentDB) — use this when deploying:
# MONGODB_URI=mongodb://edugen_user:password@docdb-cluster.cluster-xyz.ap-south-1.docdb.amazonaws.com:27017/edugen?tls=true&tlsCAFile=/app/certs/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# ─── AI APIs ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-here-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS (comma-separated list of allowed origins) ──────────────────────────
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: set to your CloudFront URL
# ALLOWED_ORIGINS=https://d1234abcdef.cloudfront.net

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=edugen-uploads-prod
# AWS credentials — in ECS, these come from the IAM task role automatically (no need to set here)
# Local dev only:
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ─── SQS (Async Worker Queue) ─────────────────────────────────────────────────
# Production: full SQS queue URL from Terraform output
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/edugen-processing-queue
# Local dev: set to "disabled" to skip SQS and process synchronously
# SQS_QUEUE_URL=disabled

# ─── Image APIs for PPT generation ───────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
PEXELS_API_KEY=your-pexels-api-key-here
